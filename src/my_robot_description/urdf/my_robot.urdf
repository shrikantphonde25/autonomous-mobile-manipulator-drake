<?xml version="1.0"?>
<robot name="my_robot">

    <material name="red">
        <color rgba="0.5 0 0 1" /> <!-- red green blue and alpha which is transperency    -->
    </material>

    <material name="grey"> 
        <color rgba="0.5 0.5 0.5 1."/>
    </material>

    <link name="base_link">
        <visual>
            <geometry>
                <box size="0.6 0.4 0.2" /> <!--length breadth height --><!--in metric format -->
            </geometry>
            <origin xyz="0 0 0.1 " rpy="0 0 0" />
            <material name="red" />
        </visual>
    </link>

    <link name="back_right_wheel_link">
        <visual>
            <geometry>
                <cylinder radius="0.1" length="0.05"/>
            </geometry>
            <origin xyz="0.0 0.0 0.0" rpy="1.57 0.0 0.0"/>
            <material name="grey"/>
        </visual>
    </link>

    <link name="back_left_wheel_link">
        <visual>
            <geometry>
                <cylinder radius="0.1" length="0.05"/>
            </geometry>
            <origin xyz="0.0 0.0 0.0" rpy="-1.57 0.0 0.0"/>
            <material name="grey"/>
        </visual>
    </link>

    <link name="front_right_wheel_link">
        <visual>
            <geometry>
                <cylinder radius="0.1" length="0.05"/>
            </geometry>
            <origin xyz="0.0 0.0 0.0" rpy="1.57 0.0 0.0"/>
            <material name="grey"/>
        </visual>
    </link>    

    <link name="front_left_wheel_link">
        <visual>
            <geometry>
                <cylinder radius="0.1" length="0.05"/>
            </geometry>
            <origin xyz="0.0 0.0 0.0" rpy="-1.57 0.0 0.0"/>
            <material name="grey"/>
        </visual>
    </link>


    <link name="base_footprint">
        <visual>
            <geometry>
                
            </geometry>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <material>
                
            </material>
        </visual>
    </link>

    <joint name="base_back_right_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="back_right_wheel_link"/>
        <origin xyz="-0.15 -0.225 0.0" rpy="0.0 0.0 0.0"/><!-- length of wheel = 0.05 divide by half + 0.2-->
        <axis xyz="0.0 1.0 0.0"/><!-- in 0 or 1-->
    </joint>

    <joint name="base_back_left_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="back_left_wheel_link"/>
        <origin xyz="-0.15 0.225 0.0" rpy="0.0 0.0 0.0"/><!-- length of wheel = 0.05 divide by half + 0.2-->
        <axis xyz="0.0 1.0 0.0"/><!-- in 0 or 1-->
    </joint>

    <joint name="base_front_right_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="front_right_wheel_link"/>
        <origin xyz="0.15 -0.225 0.0" rpy="0.0 0.0 0.0"/><!-- length of wheel = 0.05 divide by half + 0.2-->
        <axis xyz="0.0 1.0 0.0"/><!-- in 0 or 1-->
    </joint>

    <joint name="base_front_left_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="front_left_wheel_link"/>
        <origin xyz="0.15 0.225 0.0" rpy="0.0 0.0 0.0"/><!-- length of wheel = 0.05 divide by half + 0.2-->
        <axis xyz="0.0 1.0 0.0"/><!-- in 0 or 1-->
    </joint>
    

    <joint name="base_joint" type="fixed">
        <parent link="base_footprint"/>
        <child link="base_link"/>
        <origin xyz="0.0 0.0 0.1" rpy="0.0 0.0 0.0"/>
    </joint>
    
</robot>
