<joint name="link_1 to base_link" type="continuous">
  <origin xyz="0.0 0.0 0.134" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="link_1_1"/>
  <axis xyz="0.0 0.0 1.0"/>
</joint>

<joint name="link_2 to link_1" type="continuous">
  <origin xyz="0.1 0.0 0.065" rpy="0 0 0"/>
  <parent link="link_1_1"/>
  <child link="link_2_1"/>
  <axis xyz="1.0 0.0 0.0"/>
</joint>

<joint name="link_3 to link_2" type="continuous">
  <origin xyz="0.065 0.0 0.1" rpy="0 0 0"/>
  <parent link="link_2_1"/>
  <child link="link_3_1"/>
  <axis xyz="0.0 0.0 1.0"/>
</joint>

<joint name="link_4 to link_3" type="continuous">
  <origin xyz="-0.1 0.0 0.133" rpy="0 0 0"/>
  <parent link="link_3_1"/>
  <child link="link_4_1"/>
  <axis xyz="-1.0 0.0 0.0"/>
</joint>

</robot>
